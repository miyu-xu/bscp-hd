{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bscp.dev/hd/schemas/task-v1.json",
  "title": "HD AI task record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "objective",
    "status",
    "scope",
    "constraints",
    "acceptance",
    "required_gates",
    "evidence_state",
    "direction_decisions",
    "blockers",
    "human_decisions_needed",
    "next_iteration"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$" },
    "objective": { "type": "string", "minLength": 1 },
    "status": { "enum": ["planned", "in_progress", "blocked", "complete"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories", "owned_paths", "excluded_paths"],
      "properties": {
        "repositories": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "owned_paths": { "type": "array", "items": { "type": "string" } },
        "excluded_paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "criterion", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "criterion": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "required_gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code_present", "tests_authored", "mock_verified", "real_guest_verified"],
      "properties": {
        "code_present": { "type": "boolean" },
        "tests_authored": { "type": "boolean" },
        "mock_verified": { "type": "boolean" },
        "real_guest_verified": { "type": "boolean" }
      }
    },
    "direction_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision", "owner", "rationale"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "decision": { "type": "string", "minLength": 1 },
          "owner": { "enum": ["human", "ai"] },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "scope", "state"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "scope": { "enum": ["current_task", "future_milestone", "external"] },
          "state": { "enum": ["open", "resolved", "accepted"] }
        }
      }
    },
    "human_decisions_needed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "impact", "state"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "impact": { "type": "string", "minLength": 1 },
          "state": { "enum": ["open", "resolved", "deferred"] }
        }
      }
    },
    "next_iteration": { "type": "string", "minLength": 1 }
  }
}
